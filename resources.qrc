<RCC>
    <qresource prefix="/app">
        <file alias="icon.png">assets/modbus-icon.png</file>
    </qresource>
    <qresource prefix="/themes">
        <file alias="industrial.qss">styles/industrial.qss</file>
        <file alias="industrial-dark.qss">styles/industrial-dark.qss</file>
        <file alias="icons/arrow-up.svg">styles/icons/arrow-up.svg</file>
        <file alias="icons/arrow-down.svg">styles/icons/arrow-down.svg</file>
        <file alias="icons/arrow-up-light.svg">styles/icons/arrow-up-light.svg</file>
        <file alias="icons/arrow-down-light.svg">styles/icons/arrow-down-light.svg</file>
        <file alias="icons/check.svg">styles/icons/check.svg</file>
    </qresource>
</RCC>
